{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "ESNext.Disposable"],
    "types": ["node"],
    "plugins": [],
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/dispatcher/**/*.ts", "src/web/**/*.ts", "src/server.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
