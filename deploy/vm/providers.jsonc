{
  // Triage routes of the oe-vm instance ([triage] provider_config_path): the Meridian of aptul4ever, one profile per Claude
  // account. Same shape as the providers of ~/.config/opencode/opencode.jsonc; installed beside config.toml by receive.sh.
  "providers": {
    "meridian-roar": {
      "settings": { "apiKey": "x", "baseURL": "http://127.0.0.1:3456/v1" },
      "headers": { "x-meridian-profile": "roar" }
    },
    "meridian-notarify": {
      "settings": { "apiKey": "x", "baseURL": "http://127.0.0.1:3456/v1" },
      "headers": { "x-meridian-profile": "notarify" }
    },
    "meridian-everbright": {
      "settings": { "apiKey": "x", "baseURL": "http://127.0.0.1:3456/v1" },
      "headers": { "x-meridian-profile": "everbright" }
    }
  }
}
