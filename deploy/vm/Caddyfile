# Public page of the oe-vm Everflow instance. Host network, loopback only: sslh hands this name over from 443 (SNI) to
# https_port and Caddy proxies to the daemon on 127.0.0.1:8789, which accepts this Host and Origin because config.toml
# names it in [web] public_origin and asks for its own sign-in there. Port 80 belongs to teams-caddy, so the certificate
# comes through the TLS-ALPN challenge over sslh; the HTTP-01 attempt fails first and is expected.
{
	default_bind 127.0.0.1
	http_port 5082
	https_port 4449
	servers {
		protocols h1 h2
	}
}

{$EVERFLOW_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		-Server
	}
	# X-Forwarded-For carries the client address the sign-in lockout counts by
	reverse_proxy 127.0.0.1:8789
}

# Former address: its sslh line stays on the VM, so old bookmarks land here and move to the current one
everflow.217-76-49-98.sslip.io {
	redir https://{$EVERFLOW_DOMAIN}{uri} permanent
}
