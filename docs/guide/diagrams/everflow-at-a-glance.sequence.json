    "views": [
      {
        "id": "arrival",
        "label": "Arrival",
        "focus": ["teams", "store", "triage"],
        "note": "Messages wait without a batch. Once the conversation is quiet for 120 seconds, its new messages become one batch and one triage job."
      },
      {
        "id": "triage",
        "label": "Triage",
        "focus": ["triage", "vault", "store", "page"],
        "note": "Triage reads the batch, 40 earlier messages with times, title, client hints and candidate tickets, and returns one decision."
      },
      {
        "id": "start",
        "label": "Start",
        "focus": ["page", "store", "chat"],
        "note": "Nothing opens before Start. Start approves the ticket, and a job creates its chat and sends the brief."
      },
      {
        "id": "report",
        "label": "Report",
        "focus": ["collector", "chat", "store"],
        "note": "The collector waits for the turn to finish, reads the final STATUS line, renames the chat and stores the report on the ticket."
      }
    ]
  },
